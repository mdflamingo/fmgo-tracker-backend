RUN_ADDR=:8000
LOG_LEVEL=INFO
DEBUG=True
SERVER_ADDR=http://localhost:8000

POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=postgres

# URL realm'а (issuer), который отдаёт /.well-known/openid-configuration.
# НЕ путь до .../protocol/openid-connect/token
KEYCLOAK_URL=http://localhost:8155/realms/fmgo
# Публичный клиент (publicClient=true) с включённым Direct Access Grants,
# чтобы Swagger UI мог получить токен по OAuth2 password flow.
CLIENT_ID=fmgo-dev
